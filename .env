# --- LOCAL DEVELOPMENT SETTINGS ---
# (Render will automatically override these in production because of render.yaml)

SECRET_KEY=django-insecure-secure-random-key-12345
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# SQLite for local development (Render will automatically inject PostgreSQL URL)
DATABASE_URL=sqlite:///db.sqlite3

# --- PRODUCTION EXAMPLES (If deploying manually without render.yaml) ---
# SECRET_KEY=your-super-secret-long-key-for-production
# DEBUG=False
# ALLOWED_HOSTS=your-backend-name.onrender.com,127.0.0.1
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your-frontend-vercel-url.vercel.app
# DATABASE_URL=postgres://school_user:password123@dpg-cabcde123.oregon-postgres.render.com/schooldb
